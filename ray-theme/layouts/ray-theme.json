{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-big",
            "props": {
              "search": false
            }
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-list",
          "type": "block",
          "content": {
            "mod": "ray-sidebar"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-big",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-big"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-big"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "ray-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "ray-changes"
                      }
                    },
                    {
                      "id": "prs",
                      "type": "block",
                      "content": {
                        "mod": "ray-prs"
                      }
                    },
                    {
                      "id": "sessions",
                      "type": "block",
                      "content": {
                        "mod": "ray-sessions"
                      }
                    },
                    {
                      "id": "notes",
                      "type": "block",
                      "content": {
                        "mod": "ray-notes"
                      }
                    },
                    {
                      "id": "chat",
                      "type": "block",
                      "content": {
                        "mod": "ray-chat"
                      }
                    },
                    {
                      "id": "mods",
                      "type": "block",
                      "content": {
                        "mod": "ray-mods"
                      }
                    }
                  ],
                  "active": "files"
                },
                {
                  "id": "panel-low",
                  "type": "stack",
                  "hidden": true,
                  "children": [
                    {
                      "id": "low-files",
                      "type": "block",
                      "content": {
                        "mod": "ray-files"
                      }
                    },
                    {
                      "id": "low-changes",
                      "type": "block",
                      "content": {
                        "mod": "ray-changes"
                      }
                    },
                    {
                      "id": "low-prs",
                      "type": "block",
                      "content": {
                        "mod": "ray-prs"
                      }
                    },
                    {
                      "id": "low-sessions",
                      "type": "block",
                      "content": {
                        "mod": "ray-sessions"
                      }
                    },
                    {
                      "id": "low-notes",
                      "type": "block",
                      "content": {
                        "mod": "ray-notes"
                      }
                    },
                    {
                      "id": "low-chat",
                      "type": "block",
                      "content": {
                        "mod": "ray-chat"
                      }
                    },
                    {
                      "id": "low-mods",
                      "type": "block",
                      "content": {
                        "mod": "ray-mods"
                      }
                    }
                  ],
                  "active": "low-files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-bar",
          "type": "row",
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status-big",
                "props": {
                  "palette": false
                }
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "usage",
              "type": "block",
              "content": {
                "mod": "ray-usage"
              },
              "size": {
                "px": 470
              }
            },
            {
              "id": "chat-watch",
              "type": "block",
              "content": {
                "mod": "ray-chat",
                "props": {
                  "view": "watch"
                }
              },
              "size": {
                "px": 1
              }
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
